# Normalize line endings: LF in repo and working tree everywhere
* text=auto eol=lf

# Source files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.jsp text eol=lf
*.java text eol=lf

# Windows scripts that genuinely need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary
